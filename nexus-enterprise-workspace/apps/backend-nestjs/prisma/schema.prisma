generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Organizations {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String              @unique @db.VarChar(255)
  industry           String              @db.VarChar(50)
  subscription_tier  String              @default("NGO_Essential") @db.VarChar(50)
  settings           Json                @default("{}")
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @default(now()) @db.Timestamptz(6)
  ai_documents       AiDocuments[]
  ai_usage_logs      AiUsageLogs[]
  audit_logs         AuditLogs[]
  chat_threads       ChatThreads[]
  dashboards         Dashboards[]
  data_sources       DataSources[]
  deletion_requests  DeletionRequests[]
  invitations        Invitations[]
  invoices           Invoices[]
  organization_users OrganizationUsers[]
  projects           Projects[]
  report_templates   ReportTemplates[]
  reports            Reports[]
  subscriptions      Subscriptions?
  usage_quotas       UsageQuotas[]

  @@map("organizations")
}

model Users {
  id                                                              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                           String                    @unique @db.VarChar(255)
  password_hash                                                   String?                   @db.VarChar(255)
  first_name                                                      String?                   @db.VarChar(100)
  last_name                                                       String?                   @db.VarChar(100)
  is_sso_user                                                     Boolean                   @default(false)
  sso_provider                                                    String?                   @db.VarChar(50)
  sso_provider_id                                                 String?                   @db.VarChar(255)
  mfa_enabled                                                     Boolean                   @default(false)
  mfa_secret                                                      String?                   @db.VarChar(255)
  backup_codes                                                    Json?
  is_field_account                                                Boolean                   @default(false) // V024
  last_login_at                                                   DateTime?                 @db.Timestamptz(6)
  last_activity_at                                                DateTime?                 @db.Timestamptz(6)
  created_at                                                      DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at                                                      DateTime?                 @default(now()) @db.Timestamptz(6)
  ai_documents                                                    AiDocuments[]
  ai_proposals                                                    AiProposals[]
  ai_usage_logs                                                   AiUsageLogs[]
  alerts                                                          Alerts[]
  approval_history                                                ApprovalHistory[]
  audit_logs                                                      AuditLogs[]
  chat_messages                                                   ChatMessages[]
  dashboard_shares                                                DashboardShares[]
  dashboard_views                                                 DashboardViews[]
  dashboards                                                      Dashboards[]
  data_batches_data_batches_approved_by_user_idTousers            DataBatches[]             @relation("data_batches_approved_by_user_idTousers")
  data_batches                                                    DataBatches[]
  data_sources                                                    DataSources[]
  deletion_requests_deletion_requests_requested_by_user_idTousers DeletionRequests[]        @relation("deletion_requests_requested_by_user_idTousers")
  deletion_requests                                               DeletionRequests[]
  export_jobs                                                     ExportJobs[]
  mapping_templates                                               MappingTemplates[]
  message_edits                                                   MessageEdits[]
  notification_preferences                                        NotificationPreferences[]
  organization_users                                              OrganizationUsers[]
  refresh_tokens                                                  RefreshTokens[]
  report_templates                                                ReportTemplates[]
  reports                                                         Reports[]
  scheduled_exports                                               ScheduledExports[]
  shared_links                                                    SharedLinks[]
  sync_conflicts                                                  SyncConflicts[]
  sync_queue                                                      SyncQueue[]

  @@map("users")
}

model RefreshTokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  user       Users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user", where: raw("(revoked_at IS NULL)"))
  @@map("refresh_tokens")
}

model LoginAttempts {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.VarChar(255)
  ip_address   String?   @db.Inet
  success      Boolean
  attempted_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([email, attempted_at], map: "idx_login_attempts_email_time")
  @@map("login_attempts")
}

model OrganizationUsers {
  user_id         String        @db.Uuid
  organization_id String        @db.Uuid
  role            String        @db.VarChar(50)
  joined_at       DateTime?     @default(now()) @db.Timestamptz(6)
  organization    Organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user            Users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, organization_id])
  @@map("organization_users")
}

model Invitations {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  email           String        @db.VarChar(255)
  role            String        @db.VarChar(50)
  token_hash      String        @unique @db.VarChar(255)
  expires_at      DateTime      @db.Timestamptz(6)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organization    Organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id, email, expires_at], map: "idx_invitations_org_email")
  @@map("invitations")
}

model Projects {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String                    @db.Uuid
  title                    String                    @db.VarChar(255)
  budget_total             Decimal?                  @db.Decimal(15, 2)
  timezone                 String                    @default("UTC") @db.VarChar(50)
  status                   String                    @default("Draft") @db.VarChar(20)
  created_at               DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                 @default(now()) @db.Timestamptz(6)
  ai_documents             AiDocuments[]
  ai_proposals             AiProposals[]
  dashboards               Dashboards[]
  data_batches             DataBatches[]
  data_sources             DataSources[]
  logical_frameworks       LogicalFrameworks[]
  notification_preferences NotificationPreferences[]
  organization             Organizations             @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports                  Reports[]
  sync_queue               SyncQueue[]

  @@index([organization_id], map: "idx_projects_organization")
  @@map("projects")
}

model DataSources {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String             @db.Uuid
  organization_id    String             @db.Uuid
  name               String             @db.VarChar(255)
  source_type        String             @db.VarChar(50)
  configuration      Json
  is_active          Boolean            @default(true)
  last_synced_at     DateTime?          @db.Timestamptz(6)
  created_by_user_id String             @db.Uuid
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @default(now()) @db.Timestamptz(6)
  user               Users              @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       Organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project            Projects           @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mapping_templates  MappingTemplates[]
  sync_jobs          SyncJobs[]

  @@index([organization_id], map: "idx_data_sources_organization")
  @@index([project_id], map: "idx_data_sources_project")
  @@map("data_sources")
}

model SyncJobs {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_source_id String        @db.Uuid
  status         String        @default("PENDING") @db.VarChar(20)
  started_at     DateTime?     @db.Timestamptz(6)
  completed_at   DateTime?     @db.Timestamptz(6)
  rows_processed Int           @default(0)
  error_message  String?
  metadata       Json?
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  data_batches   DataBatches[]
  data_source    DataSources   @relation(fields: [data_source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([data_source_id, status], map: "idx_sync_jobs_source_status")
  @@map("sync_jobs")
}

model DataBatches {
  id                                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sync_job_id                                   String?            @db.Uuid
  project_id                                    String             @db.Uuid
  raw_payload                                   Json
  sensitive_fields_encrypted                    Bytes?
  sensitive_fields_key_id                       String?            @db.VarChar(100)
  cleaned_payload                               Json?
  cleaning_status                               String             @default("PENDING") @db.VarChar(20)
  validation_errors                             Json?
  cleaning_suggestions                          Json?
  submitted_by_user_id                          String?            @db.Uuid
  submitted_at                                  DateTime?          @db.Timestamptz(6)
  approved_by_user_id                           String?            @db.Uuid
  approved_at                                   DateTime?          @db.Timestamptz(6)
  rejection_reason                              String?
  created_at                                    DateTime?          @default(now()) @db.Timestamptz(6)
  ai_cleaning_jobs                              AiCleaningJobs[]
  approval_history                              ApprovalHistory[]
  users_data_batches_approved_by_user_idTousers Users?             @relation("data_batches_approved_by_user_idTousers", fields: [approved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project                                       Projects           @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                                          Users?             @relation(fields: [submitted_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sync_job                                      SyncJobs?          @relation(fields: [sync_job_id], references: [id], onUpdate: NoAction)
  indicator_history                             IndicatorHistory[]
  indicator_values                              IndicatorValues[]
  sync_queue                                    SyncQueue[]

  @@index([project_id, cleaning_status], map: "idx_data_batches_project_status")
  @@index([sync_job_id], map: "idx_data_batches_sync_job")
  @@map("data_batches")
}

model MappingTemplates {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_source_id     String      @db.Uuid
  name               String      @db.VarChar(255)
  mapping_config     Json
  is_active          Boolean     @default(true)
  created_by_user_id String      @db.Uuid
  created_at         DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?   @default(now()) @db.Timestamptz(6)
  user               Users       @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_source        DataSources @relation(fields: [data_source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([data_source_id], map: "idx_mapping_templates_source", where: raw("is_active"))
  @@map("mapping_templates")
}

model LogicalFrameworks {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String              @db.Uuid
  level              String              @db.VarChar(50)
  code               String?             @db.VarChar(50)
  name               String              @db.VarChar(255)
  description        String?
  parent_id          String?             @db.Uuid
  order_index        Int                 @default(0)
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  indicators         Indicators[]
  logical_framework  LogicalFrameworks?  @relation("LogicalFrameworksRelation", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  logical_frameworks LogicalFrameworks[] @relation("LogicalFrameworksRelation")
  project            Projects            @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_id], map: "idx_logical_frameworks_parent")
  @@index([project_id], map: "idx_logical_frameworks_project")
  @@map("logical_frameworks")
}

model Indicators {
  id                                                                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  framework_id                                                                String             @db.Uuid
  name                                                                        String             @db.VarChar(255)
  unit                                                                        String?            @db.VarChar(50)
  formula_type                                                                String             @db.VarChar(50)
  formula_params                                                              Json?
  target_value                                                                Decimal?           @db.Decimal(15, 2)
  baseline_value                                                              Decimal?           @db.Decimal(15, 2)
  periodicity                                                                 String?            @db.VarChar(50)
  created_at                                                                  DateTime?          @default(now()) @db.Timestamptz(6)
  indicator_history_indicator_history_cascade_source_indicator_idToindicators IndicatorHistory[] @relation("indicator_history_cascade_source_indicator_idToindicators")
  indicator_history                                                           IndicatorHistory[]
  indicator_values                                                            IndicatorValues[]
  logical_framework                                                           LogicalFrameworks  @relation(fields: [framework_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([framework_id], map: "idx_indicators_framework")
  @@map("indicators")
}

model ApprovalHistory {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_batch_id        String      @db.Uuid
  action               String      @db.VarChar(20)
  performed_by_user_id String      @db.Uuid
  comment              String?
  previous_status      String?     @db.VarChar(20)
  new_status           String?     @db.VarChar(20)
  created_at           DateTime?   @default(now()) @db.Timestamptz(6)
  data_batche          DataBatches @relation(fields: [data_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                 Users       @relation(fields: [performed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([data_batch_id, created_at], map: "idx_approval_history_batch")
  @@map("approval_history")
}

model NotificationPreferences {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  project_id        String?   @db.Uuid
  notification_type String    @db.VarChar(50)
  channel           String    @db.VarChar(20)
  is_enabled        Boolean   @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  project           Projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              Users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, project_id, notification_type, channel])
  @@map("notification_preferences")
}

model ChatThreads {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type     String         @db.VarChar(50)
  entity_id       String         @db.Uuid
  organization_id String         @db.Uuid
  title           String?        @db.VarChar(255)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @default(now()) @db.Timestamptz(6)
  alerts          Alerts[]
  chat_messages   ChatMessages[]
  organization    Organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_chat_threads_entity")
  @@index([organization_id], map: "idx_chat_threads_organization")
  @@map("chat_threads")
}

model ChatMessages {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id         String         @db.Uuid
  user_id           String?        @db.Uuid
  content           String
  is_system_message Boolean        @default(false)
  mentions          Json?
  attachments       Json?
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?      @default(now()) @db.Timestamptz(6)
  chat_thread       ChatThreads    @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              Users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  message_edits     MessageEdits[]

  @@index([thread_id, created_at], map: "idx_chat_messages_thread")
  @@map("chat_messages")
}

model MessageEdits {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id        String       @db.Uuid
  old_content       String
  new_content       String
  edited_by_user_id String       @db.Uuid
  edited_at         DateTime?    @default(now()) @db.Timestamptz(6)
  user              Users        @relation(fields: [edited_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chat_message      ChatMessages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("message_edits")
}

model Alerts {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id           String?      @db.Uuid
  entity_type         String       @db.VarChar(50)
  entity_id           String       @db.Uuid
  alert_type          String       @db.VarChar(50)
  severity            String       @db.VarChar(20)
  message             String
  metadata            Json?
  is_resolved         Boolean      @default(false)
  resolved_by_user_id String?      @db.Uuid
  resolved_at         DateTime?    @db.Timestamptz(6)
  created_at          DateTime?    @default(now()) @db.Timestamptz(6)
  user                Users?       @relation(fields: [resolved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chat_thread         ChatThreads? @relation(fields: [thread_id], references: [id], onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_alerts_entity")
  @@index([is_resolved], map: "idx_alerts_unresolved", where: raw("(NOT is_resolved)"))
  @@map("alerts")
}

model AiDocuments {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String           @db.Uuid
  organization_id     String           @db.Uuid
  name                String           @db.VarChar(255)
  file_url            String           @db.VarChar(500)
  file_type           String           @db.VarChar(50)
  file_size           BigInt?
  processing_status   String           @default("PENDING") @db.VarChar(20)
  chunk_count         Int              @default(0)
  uploaded_by_user_id String           @db.Uuid
  created_at          DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?        @default(now()) @db.Timestamptz(6)
  organization        Organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project             Projects         @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                Users            @relation(fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_proposals        AiProposals[]
  document_chunks     DocumentChunks[]

  @@index([project_id], map: "idx_ai_documents_project")
  @@map("ai_documents")
}

model DocumentChunks {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id      String                 @db.Uuid
  chunk_index      Int
  content          String
  embedding_vector Unsupported("vector")?
  metadata         Json?
  created_at       DateTime?              @default(now()) @db.Timestamptz(6)
  ai_document      AiDocuments            @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([document_id], map: "idx_document_chunks_document")
  @@index([embedding_vector], map: "idx_document_chunks_embedding")
  @@map("document_chunks")
}

model AiProposals {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String       @db.Uuid
  document_id        String?      @db.Uuid
  proposal_type      String       @db.VarChar(50)
  proposal_data      Json
  status             String       @default("DRAFT") @db.VarChar(20)
  created_by_user_id String       @db.Uuid
  created_at         DateTime?    @default(now()) @db.Timestamptz(6)
  user               Users        @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_document        AiDocuments? @relation(fields: [document_id], references: [id], onUpdate: NoAction)
  project            Projects     @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([project_id, status], map: "idx_ai_proposals_project")
  @@map("ai_proposals")
}

model AiCleaningJobs {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_batch_id String      @db.Uuid
  model_used    String      @db.VarChar(50)
  input_data    Json
  output_data   Json?
  suggestions   Json?
  status        String      @default("PENDING") @db.VarChar(20)
  tokens_used   Int?
  cost_usd      Decimal?    @db.Decimal(10, 4)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  completed_at  DateTime?   @db.Timestamptz(6)
  data_batche   DataBatches @relation(fields: [data_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([data_batch_id], map: "idx_ai_cleaning_jobs_batch")
  @@map("ai_cleaning_jobs")
}

model AiUsageLogs {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  user_id         String?       @db.Uuid
  endpoint        String        @db.VarChar(100)
  model           String        @db.VarChar(50)
  tokens_input    Int?
  tokens_output   Int?
  cost_usd        Decimal?      @db.Decimal(10, 4)
  anonymized      Boolean       @default(true)
  locale          String        @default("fr") @db.VarChar(10)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organization    Organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user            Users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([organization_id, created_at], map: "idx_ai_usage_logs_org_time")
  @@map("ai_usage_logs")
}

model Reports {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id           String             @db.Uuid
  organization_id      String             @db.Uuid
  name                 String             @db.VarChar(255)
  report_type          String             @db.VarChar(50)
  template_id          String?            @db.Uuid
  period_start         DateTime           @db.Date
  period_end           DateTime           @db.Date
  status               String             @default("DRAFT") @db.VarChar(20)
  content              Json?
  file_url             String?            @db.VarChar(500)
  file_format          String?            @db.VarChar(20)
  generated_by_user_id String             @db.Uuid
  generated_at         DateTime?          @db.Timestamptz(6)
  created_at           DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?          @default(now()) @db.Timestamptz(6)
  report_templates     ReportTemplates?   @relation(fields: [template_id], references: [id], onUpdate: NoAction, map: "fk_reports_template")
  user                 Users              @relation(fields: [generated_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization         Organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project              Projects           @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scheduled_exports    ScheduledExports[]

  @@index([project_id, period_start, period_end], map: "idx_reports_project")
  @@map("reports")
}

model ReportTemplates {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String        @db.Uuid
  name               String        @db.VarChar(255)
  description        String?
  template_config    Json
  is_system_template Boolean       @default(false)
  created_by_user_id String        @db.Uuid
  created_at         DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?     @default(now()) @db.Timestamptz(6)
  user               Users         @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       Organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
