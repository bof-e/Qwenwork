  data_batch_id      String?         @db.Uuid
  status             String          @default("RECEIVED") @db.VarChar(20)
  created_offline_at DateTime        @db.Timestamptz(6)
  received_at        DateTime?       @default(now()) @db.Timestamptz(6)
  sync_conflicts     SyncConflicts[]
  data_batche        DataBatches?    @relation(fields: [data_batch_id], references: [id], onUpdate: NoAction)
  project            Projects        @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user               Users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

