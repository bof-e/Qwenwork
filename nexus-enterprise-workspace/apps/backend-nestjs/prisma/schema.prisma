model IndicatorHistory {
  id                                                                   String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indicator_id                                                         String       @db.Uuid
  version                                                              Int
  period_start                                                         DateTime     @db.Date
  period_end                                                           DateTime     @db.Date
  value                                                                Decimal      @db.Decimal(15, 2)
  target_value                                                         Decimal?     @db.Decimal(15, 2)
  baseline_value                                                       Decimal?     @db.Decimal(15, 2)
  formula_type_snapshot                                                String?      @db.VarChar(50)
  data_source_batch_id                                                 String?      @db.Uuid
  triggered_by                                                         String       @db.VarChar(20)
  cascade_source_indicator_id                                          String?      @db.Uuid
  calculated_at                                                        DateTime     @default(now()) @db.Timestamptz(6)
  organization_id                                                      String       @db.Uuid
  indicators_indicator_history_cascade_source_indicator_idToindicators Indicators?  @relation("indicator_history_cascade_source_indicator_idToindicators", fields: [cascade_source_indicator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_batche                                                          DataBatches? @relation(fields: [data_source_batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  indicator                                                            Indicators   @relation(fields: [indicator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id, calculated_at])
  @@index([indicator_id, period_start, period_end, version(sort: Desc)], map: "idx_indicator_history_lookup")
  @@index([organization_id, calculated_at], map: "idx_indicator_history_org")
  @@index([calculated_at(sort: Desc)])
  @@map("indicator_history")
}

model IndicatorValues {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
