model SyncConflicts {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sync_queue_id       String    @db.Uuid
  conflict_type       String    @db.VarChar(50)
  local_payload       Json
  server_payload      Json
  resolution          String?   @db.VarChar(20)
  resolved_payload    Json?
  resolved_by_user_id String?   @db.Uuid
  resolved_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  user                Users?    @relation(fields: [resolved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sync_queue          SyncQueue @relation(fields: [sync_queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sync_queue_id], map: "idx_sync_conflicts_unresolved", where: raw("(resolution IS NULL)"))
  @@map("sync_conflicts")
}

model Subscriptions {
